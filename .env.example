# Port d'écoute (défaut: 2704)
PORT=2704

# Adresse contact VAPID (push notifications) — format mailto: ou https://
VAPID_CONTACT=mailto:contact@example.com

# Giphy API key (https://developers.giphy.com/dashboard/) — sans, le bouton GIF ne marche pas
GIPHY_API_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add site)
# Sans ces deux clés, le captcha est bypass (mode dev) ; le rate-limit reste actif.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
